# Copy to .env and fill in values. Never commit .env to git.

# Google OAuth (django-allauth)
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# → OAuth client ID (Web application). Add authorized redirect URI:
#   http://localhost:8000/accounts/google/login/callback/
# (Optional for dev if you browse via IP: http://127.0.0.1:8000/accounts/google/login/callback/)
# (and your production domain later). Then run: python manage.py setup_oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Maps (checkout address step)
GOOGLE_MAPS_API_KEY=

# reCAPTCHA v3 (newsletter footer)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Twilio SMS — OPTIONAL; not used unless PHONE_VERIFICATION_ENABLED=true
# https://console.twilio.com
#
# Greece requires alphanumeric sender (US +1 cannot deliver to +30):
#   TWILIO_ALPHANUMERIC_SENDER=Kokkoris
# Run: python manage.py check_twilio
#
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_ALPHANUMERIC_SENDER=Kokkoris

# Phone SMS gate at login/checkout — leave false (phone is a normal form field)
PHONE_VERIFICATION_ENABLED=false

# SMTP / transactional email (order updates, password reset, etc.)
# Gmail example: smtp.gmail.com, port 587, App Password (not your login password)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Kokkoris Pet Food <noreply@kokkorispetfood.gr>
SITE_BASE_URL=http://127.0.0.1:8000

# Stripe Payments (checkout step 3 — card payments)
# Dashboard: https://dashboard.stripe.com/apikeys
# Webhook endpoint: https://www.kokkorispetfood.gr/checkout/stripe/webhook/
# Local testing: stripe listen --forward-to localhost:8000/checkout/stripe/webhook/
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Box Now locker delivery (Partner API + Map Widget)
# Partner registration: ict@boxnow.gr / sales@boxnow.gr
# Docs: https://boxnow.gr/en/partner-api — setup guide: docs/BOXNOW_SETUP.md
#
# Minimum for checkout widget (locker map):
BOXNOW_PARTNER_ID=
#
# Full API (create delivery requests after order):
BOXNOW_OAUTH_CLIENT_ID=
BOXNOW_OAUTH_CLIENT_SECRET=
# Staging (default) vs production:
# BOXNOW_API_URL=https://api-stage.boxnow.gr
# BOXNOW_LOCATION_API_URL=https://locationapi-stage.boxnow.gr
# BOXNOW_API_URL=https://api-production.boxnow.gr
# BOXNOW_LOCATION_API_URL=https://locationapi-production.boxnow.gr
BOXNOW_ORIGIN_LOCATION_ID=
BOXNOW_NOTIFY_EMAIL=
BOXNOW_ORIGIN_CONTACT_NAME=
BOXNOW_ORIGIN_CONTACT_PHONE=
BOXNOW_ORIGIN_CONTACT_EMAIL=
#
# Shipping fees per locker compartment (€) — your Box Now partner contract:
BOXNOW_FEE_SMALL=1.80
BOXNOW_FEE_MEDIUM=2.50
BOXNOW_FEE_LARGE=3.50
# Official locker limit (BOX NOW locker-info): 20 kg, Large 36×45×60 cm
BOXNOW_MAX_WEIGHT_KG=20.0
# HMAC secret from BOX NOW for POST /checkout/boxnow/webhook/
BOXNOW_WEBHOOK_SECRET=

# Free shipping for orders at or above this cart subtotal (€):
FREE_SHIPPING_ORDER_MINIMUM=60.00
# Flat courier (door delivery) fee below that threshold (€). Box Now is unchanged.
COURIER_FLAT_FEE=3.20
