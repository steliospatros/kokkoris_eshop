# Copy to .env and fill in values. Never commit .env to git.

# Google OAuth (django-allauth)
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# → OAuth client ID (Web application). Add authorized redirect URI:
#   http://localhost:8000/accounts/google/login/callback/
# (Optional for dev if you browse via IP: http://127.0.0.1:8000/accounts/google/login/callback/)
# (and your production domain later). Then run: python manage.py setup_oauth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Maps (checkout address step)
GOOGLE_MAPS_API_KEY=

# reCAPTCHA v3 (newsletter footer)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
